# Database
DATABASE_URL=sqlite+aiosqlite:///./data/ict_bot.db

# Bybit
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear

# For list fields, use JSON array format.
SYMBOLS=["BTCUSDT","ETHUSDT","SOLUSDT"]
KLINE_INTERVAL=1

# Time
NY_TIMEZONE=America/New_York

# Signal defaults
EQUAL_LEVEL_TOLERANCE_PCT=0.08
FVG_MIN_SIZE_PCT=0.02
LOOKBACK_CANDLES=50
DISPLACEMENT_MIN_PCT=0.10
OPENING_RANGE_GAP_WIDE_POINTS=40

# News hours (NY local hour list)
HIGH_IMPACT_NEWS_HOURS=[8,10,14]
